# Gemini is now called exclusively through the secure Cloudflare Worker proxy.
# Never put a real GEMINI_API_KEY in the browser.

# Local development (run `wrangler dev` in the worker/ folder)
VITE_GEMINI_PROXY_URL=http://localhost:8787

# Production (set this to your deployed Worker URL, e.g. https://gemini-proxy.yourname.workers.dev)
# VITE_GEMINI_PROXY_URL=https://gemini-proxy.yourname.workers.dev
